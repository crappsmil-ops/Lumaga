{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "sender": {
      "type": "string",
      "enum": [
        "user",
        "bot",
        "admin"
      ]
    },
    "text": {
      "type": "string"
    },
    "needs_human": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id",
    "sender",
    "text"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}